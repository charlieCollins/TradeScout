# Alternative screening universes for different strategies
sp500_large_cap:
  description: "S&P 500 large cap universe (market cap > $50B)"
  symbols: []  # Could be populated from S&P 500 list
  
nasdaq100:
  description: "NASDAQ 100 technology-focused universe"  
  symbols: []  # Could be populated from NASDAQ 100 list
  
high_volume_only:
  description: "Extreme high-volume stocks (>10M daily volume)"
  min_avg_volume: 10000000
  symbols: []
  
extended_hours_active:
  description: "Stocks with significant extended hours activity"
  symbols: []

# Configuration for dynamic universe updates
dynamic_screening:
  enabled: false  # Enable dynamic universe updates
  update_frequency_days: 7
  volume_lookback_days: 30
  market_cap_threshold: 10000000000
  exclude_sectors: ["utilities", "real_estate"]  # Sectors to exclude from dynamic updates

