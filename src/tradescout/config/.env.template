# TradeScout Environment Variables Template  
# Copy this file to .env and fill in your actual API keys
# IMPORTANT: Never commit .env to git - it's in .gitignore

# =================================
# POLYGON.IO API (Primary Data Source)
# =================================

# Polygon.io Commercial License  
# Sign up at: https://polygon.io/
# Documentation: https://polygon.io/docs
# Extended hours data: https://polygon.io/knowledge-base/article/does-polygon-offer-pre-market-and-after-hours-data
POLYGON_API_KEY=your_polygon_api_key_here

# =================================
# TIINGO COMMERCIAL API (Disabled - Plan expires 2025-10-02)
# =================================

# Tiingo Commercial License (DISABLED)
# Documentation: https://www.tiingo.com/documentation/general/overview  
# TIINGO_API_KEY=your_tiingo_commercial_api_key_here

# =================================
# DEVELOPMENT SETTINGS  
# =================================

# Set to 'development', 'testing', or 'production'
ENVIRONMENT=development

# Database (SQLite for local development)
DATABASE_URL=sqlite:///data/databases/tradescout.db

# =================================
# SECURITY NOTES
# =================================

# Never share these credentials or commit them to version control!
# The .env file is excluded from git via .gitignore